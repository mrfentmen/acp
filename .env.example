# ACP agents — copy to .env and export, or pass as real env vars.

# --- logging -----------------------------------------------------------------
# Logs always go to stderr; stdout is the ACP channel and must stay clean.
ACP_LOG_LEVEL=INFO

# --- A2A bridge --------------------------------------------------------------
# Remote A2A servers to expose as editor tools: name=url pairs, comma separated.
ACP_A2A_ENDPOINTS=nyc311=http://127.0.0.1:8787,nycflood=http://127.0.0.1:8788,nycwater=http://127.0.0.1:8789
# Where the bridge listens for A2A push notifications so it can relay them into the
# editor session. 0 picks a free port (the URL is reported back in the session).
ACP_BRIDGE_PUSH_PORT=8790

# --- civic -------------------------------------------------------------------
# Optional Socrata app token (raises NYC Open Data rate limits; not required).
CIVIC_APP_TOKEN=

# --- hazards -----------------------------------------------------------------
# NWS requires a User-Agent that identifies you and gives them a contact address;
# without one api.weather.gov answers 403. Set this before any public use.
HAZARDS_USER_AGENT=acp-hazards/1.0 (+https://github.com/mrfentmen/acp)
HAZARDS_CACHE_TTL=60
HAZARDS_HTTP_TIMEOUT=20

# --- ledger ------------------------------------------------------------------
# The Treasury API needs no key at all; this is just how you identify yourself.
LEDGER_USER_AGENT=acp-ledger/1.0 (+https://github.com/mrfentmen/acp)
LEDGER_BASE_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service
# Treasury data updates daily (debt) or monthly (interest rates), so cache generously.
LEDGER_CACHE_TTL=900
LEDGER_HTTP_TIMEOUT=20

# --- vehicles ----------------------------------------------------------------
# NHTSA's recall, complaint and vPIC services need no key at all; this is how you
# identify yourself. VIN decodes are cached for a day, the rest for 30 minutes.
VEHICLES_USER_AGENT=acp-vehicles/1.0 (+https://github.com/mrfentmen/acp)
VEHICLES_BASE_URL=https://api.nhtsa.gov
VEHICLES_VPIC_URL=https://vpic.nhtsa.dot.gov
VEHICLES_CACHE_TTL=1800
VEHICLES_HTTP_TIMEOUT=20

# --- wildfire ----------------------------------------------------------------
# NIFC's ArcGIS incident layer is keyless; this is just how you identify yourself.
# The layer is revised as the managing agencies report, so 5 minutes is a fine cache.
WILDFIRE_USER_AGENT=acp-wildfire/1.0 (+https://github.com/mrfentmen/acp)
WILDFIRE_BASE_URL=https://services3.arcgis.com/T4QMspbfLg3qTGWY/arcgis/rest/services
WILDFIRE_CACHE_TTL=300
WILDFIRE_HTTP_TIMEOUT=30

# --- air ---------------------------------------------------------------------
# Open-Meteo's air-quality model needs no key; this is just how you identify yourself.
# The model is refreshed hourly, so a 5-minute cache is already generous.
AIR_USER_AGENT=acp-air/1.0 (+https://github.com/mrfentmen/acp)
AIR_BASE_URL=https://air-quality-api.open-meteo.com
AIR_CACHE_TTL=300
AIR_HTTP_TIMEOUT=20

# --- aurora -------------------------------------------------------------------
# NOAA SWPC's feeds (Kp index, 3-day Kp forecast, OVATION aurora) need no key.
# The 1-minute Kp feed updates every minute; the forecast and OVATION hourly.
AURORA_USER_AGENT=acp-aurora/1.0 (+https://github.com/mrfentmen/acp)
AURORA_BASE_URL=https://services.swpc.noaa.gov
AURORA_CACHE_TTL=300
AURORA_HTTP_TIMEOUT=30

# --- rivers -------------------------------------------------------------------
# The USGS water services (site file, instantaneous values) need no key at all.
# They answer 503 under load, so the reader retries; the site file is cached for an hour.
RIVERS_USER_AGENT=acp-rivers/1.0 (+https://github.com/mrfentmen/acp)
RIVERS_BASE_URL=https://waterservices.usgs.gov
RIVERS_CACHE_TTL=300
RIVERS_HTTP_TIMEOUT=30
