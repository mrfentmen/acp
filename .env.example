# ACP agents — copy to .env and export, or pass as real env vars.

# --- logging -----------------------------------------------------------------
# Logs always go to stderr; stdout is the ACP channel and must stay clean.
ACP_LOG_LEVEL=INFO

# --- A2A bridge --------------------------------------------------------------
# Remote A2A servers to expose as editor tools: name=url pairs, comma separated.
ACP_A2A_ENDPOINTS=nyc311=http://127.0.0.1:8787,nycflood=http://127.0.0.1:8788,nycwater=http://127.0.0.1:8789
# Where the bridge listens for A2A push notifications so it can relay them into the
# editor session. 0 picks a free port (the URL is reported back in the session).
ACP_BRIDGE_PUSH_PORT=8790

# --- civic -------------------------------------------------------------------
# Optional Socrata app token (raises NYC Open Data rate limits; not required).
CIVIC_APP_TOKEN=
